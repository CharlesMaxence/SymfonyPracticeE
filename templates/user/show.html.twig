{% extends 'base.html.twig' %}

{% block title %}User{% endblock %}

{% block body %}
    <h1>{{"User"|trans}}</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>{{"Id"|trans}}</th>
                <td>{{ user.id }}</td>
            </tr>
            <tr>
                <th>{{"Email"|trans}}</th>
                <td>{{ user.email }}</td>
            </tr>
            <tr>
                <th>{{"Roles"|trans}}</th>
                <td>{{ user.roles ? user.roles|json_encode : '' }}</td>
            </tr>
            <tr>
                <th>{{"IsVerified"|trans}}</th>
                <td>{{ user.isVerified ? 'Yes' : 'No' }}</td>
            </tr>
        </tbody>
    </table>

    <a class="btn ntn-primary" href="{{ path('app_user_index') }}">{{"back to list"|trans}}</a>

    <a class="btn ntn-secondary" href="{{ path('app_user_edit', {'id': user.id}) }}">{{"edit"|trans}}</a>

    {{ include('user/_delete_form.html.twig') }}
{% endblock %}
