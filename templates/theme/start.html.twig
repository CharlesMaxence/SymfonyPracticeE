{% extends 'base.html.twig' %}

{% block title %}{{ theme.title }}{% endblock %}

{% block body %}
    <h1>{{ theme.title }}</h1>
    <p>{{ theme.description }}</p>

    {% for slideshow in theme.slideshows %}
        {% for slide in slideshow.slides %}
            {% if slide.image %}
                <img src="{{ slide.image.path }}" alt="Image du slide" width="200">
            {% endif %}
        {% endfor %}
    {% endfor %}
{% endblock %}