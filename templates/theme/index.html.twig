{% extends 'base.html.twig' %}

{% block title %}{{"Theme index"|trans}}{% endblock %}

{% block body %}
<div class="container">
    <h1>Theme index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>{{"Id"|trans}}</th>
                <th>{{"Title"|trans}}</th>
                <th>{{"Step"|trans}}</th>
                <th>{{"Description"|trans}}</th>
                <th>{{"actions"|trans}}</th>
            </tr>
        </thead>
        <tbody>
        {% for theme in themes %}
            <tr>
                <td>{{ theme.id }}</td>
                <td>{{ theme.title }}</td>gmail.com
                <td>{{ theme.step }}</td>
                <td>{{ theme.description }}</td>
                <td>
                    <a href="{{ path('app_theme_show', {'id': theme.id}) }}">{{"show"|trans}}</a>
                    <a href="{{ path('app_theme_edit', {'id': theme.id}) }}">{{"edit"|trans}}</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5">{{"no records found"|trans}}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_theme_new') }}"><button class="btn btn-primary">{{"Create new"|trans}}</button></a>
</div>
{% endblock %}
