{% extends 'base.html.twig' %}

{% block title %}Country{% endblock %}

{% block body %}
    <h1>{{"Country"|trans}}</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>{{"Id"|trans}}</th>
                <td>{{ country.id }}</td>
            </tr>
            <tr>
                <th>{{"Name"|trans}}</th>
                <td>{{ country.name }}</td>
            </tr>
        </tbody>
    </table>

    <a class="btn btn-primary" href="{{ path('app_country_index') }}">{{"back to list"|trans}}</a>

    <a class="btn btn-primary" href="{{ path('app_country_edit', {'id': country.id}) }}">{{"edit"|trans}}</a>

    {{ include('country/_delete_form.html.twig') }}
{% endblock %}
